# Environment variables for NexaShell
# Copy to .env.local for local overrides (never commit .env*)

# Vite dev server port. Read by vite.config.ts (server.port); defaults to 1420.
# When set, it must match the devUrl configured in tauri.conf.json.
VITE_PORT=1420

# Override the app version displayed in the Settings > About panel.
# If unset, the app falls back to a placeholder ('0.0.0'); it is NOT
# auto-synced from Cargo.toml — that sync only keeps package.json in step.
VITE_APP_VERSION=

# Enable debug mode ('true' to enable)
VITE_DEBUG=false

# Tauri dev HMR host (set to your LAN IP to enable remote HMR)
TAURI_DEV_HOST=
