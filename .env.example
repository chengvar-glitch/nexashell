# NexaShell environment variables
# Copy to .env.local for local overrides (never commit .env*)

# Vite dev server port (default 1420, must match tauri.conf.json devUrl)
VITE_PORT=1420

# Override the displayed app version (defaults to Cargo.toml version)
VITE_APP_VERSION=

# Enable debug mode ('true' to enable)
VITE_DEBUG=false

# Tauri dev HMR host (set to your LAN IP to enable remote HMR)
TAURI_DEV_HOST=
